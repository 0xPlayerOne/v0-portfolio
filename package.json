{
  "name": "v0-portfolio",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cloudflare:deploy": "opennextjs-cloudflare deploy",
    "cloudflare:upload": "opennextjs-cloudflare upload",
    "cloudflare:preview": "opennextjs-cloudflare preview",
    "preview": "bun run cloudflare:build && bun run cloudflare:preview",
    "deploy": "bun run cloudflare:build && bun run cloudflare:deploy",
    "upload": "bun run cloudflare:build && bun run cloudflare:upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --dom --isolate",
    "test:unit": "bun run test:coverage",
    "test:coverage": "bun test --coverage --dom --isolate --max-concurrency=1",
    "test:watch": "bun test --dom --watch",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@happy-dom/global-registrator": "^20.11.6",
    "@opennextjs/cloudflare": "1.20.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.0",
    "eslint-config-next": "16.3.3",
    "espree": "^11.2.0",
    "happy-dom": "^20.11.6",
    "lint-staged": "^17.3.0",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "7.0.2",
    "wrangler": "4.127.1"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
