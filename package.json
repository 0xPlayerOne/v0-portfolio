{
  "name": "v0-portfolio",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run cloudflare:build && bun run performance:artifacts",
    "start": "wrangler dev --local",
    "cloudflare:build": "astro build && wrangler deploy --dry-run --outdir .worker-build",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:upload": "wrangler versions upload",
    "cloudflare:preview": "wrangler dev --local",
    "preview": "bun run cloudflare:build && bun run cloudflare:preview",
    "deploy": "bun run cloudflare:build && bun run cloudflare:deploy",
    "upload": "bun run cloudflare:build && bun run cloudflare:upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "astro check",
    "test": "bun test --dom --isolate",
    "test:unit": "bun run test:coverage",
    "test:integration": "bun run cloudflare:build && bun run performance:audit",
    "test:coverage": "bun test --coverage --dom --isolate --max-concurrency=1",
    "test:watch": "bun test --dom --watch",
    "type:check": "astro check",
    "performance:check": "bun run build",
    "performance:artifacts": "bun scripts/check-performance-artifacts.mjs",
    "performance:audit": "bun scripts/audit-performance.mjs",
    "canary:check": "bun run format:check && bun run lint && bun run typecheck && bun run test:unit && bun run performance:check && bun run performance:audit",
    "test:e2e": "bun run build && bunx playwright install chromium && playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "astro": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "bun@1.4.0"
}
