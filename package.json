{
  "name": "v0-portfolio",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build && bun run performance:artifacts",
    "start": "next start",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cloudflare:deploy": "opennextjs-cloudflare deploy",
    "cloudflare:upload": "opennextjs-cloudflare upload",
    "cloudflare:preview": "opennextjs-cloudflare preview",
    "preview": "bun run cloudflare:build && bun run cloudflare:preview",
    "deploy": "bun run cloudflare:build && bun run cloudflare:deploy",
    "upload": "bun run cloudflare:build && bun run cloudflare:upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --dom --isolate",
    "test:unit": "bun run test:coverage",
    "test:integration": "bun run build && bun run performance:audit",
    "test:coverage": "bun test --coverage --dom --isolate --max-concurrency=1",
    "test:watch": "bun test --dom --watch",
    "type:check": "tsc --noEmit",
    "performance:artifacts": "bun scripts/check-performance-artifacts.mjs",
    "performance:audit": "bun scripts/audit-performance.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.0",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "8.5.28",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "postcss": "8.5.28",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.0"
}
